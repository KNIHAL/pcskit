{
  "name": "@knihal/pcskit",
  "version": "0.1.0",
  "description": "Project Continuity System - AI-independent development continuity and handoff",
  "license": "Apache-2.0",
  "author": "KNIHAL (https://github.com/KNIHAL)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KNIHAL/pcskit.git"
  },
  "homepage": "https://github.com/KNIHAL/pcskit#readme",
  "bugs": {
    "url": "https://github.com/KNIHAL/pcskit/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "handoff",
    "continuity",
    "mcp",
    "claude",
    "cursor",
    "git",
    "cli"
  ],
  "type": "module",
  "bin": {
